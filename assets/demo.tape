# Records assets/demo.gif: the band through one scripted session (tools/demo.ts).
#   vhs assets/demo.tape        from the repository's root
Output assets/demo.gif
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 16
Set Width 1280
Set Height 560
Set Padding 18
Set Framerate 12
Set Theme { "name": "binnacle", "background": "#1a1b26", "foreground": "#c0caf5", "cursor": "#1a1b26", "black": "#15161e", "red": "#f7768e", "green": "#9ece6a", "yellow": "#e0af68", "blue": "#7aa2f7", "magenta": "#bb9af7", "cyan": "#7dcfff", "white": "#a9b1d6", "brightBlack": "#414868", "brightRed": "#f7768e", "brightGreen": "#9ece6a", "brightYellow": "#e0af68", "brightBlue": "#7aa2f7", "brightMagenta": "#bb9af7", "brightCyan": "#7dcfff", "brightWhite": "#c0caf5", "selection": "#283457" }
Hide
Type "clear && bun tools/demo.ts"
Enter
Sleep 600ms
Show
Sleep 25s
